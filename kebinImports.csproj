<!--
  IDE support only: lets Visual Studio, Rider and VS Code compile the scripts against the Unity assemblies.
  Unity compiles the package itself, and the release artifacts are built by .github/workflows/build.yml.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481-windows</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_EDITOR_WIN;UNITY_2022;UNITY_2022_3;UNITY_2022_3_OR_NEWER;UNITY_2019_4_OR_NEWER;UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
    <!-- Unity 2022.3.22f1 is the Unity version currently supported by VRChat. Override with: dotnet build -p:UnityEditorPath=... -->
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data</UnityEditorPath>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Reference exactly what Unity's own script compilation references: every assembly in Managed\UnityEngine
      (the *Module.dll assemblies plus the UnityEngine.dll / UnityEditor.dll type-forwarding facades that live
      next to them). Do NOT add Managed\UnityEngine.dll or Managed\UnityEditor.dll from the parent folder; those
      are the full legacy assemblies and referencing them alongside the modules makes every type ambiguous (CS0433).
    -->
    <Reference Include="$(UnityEditorPath)\Managed\UnityEngine\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework assemblies the scripts use that SDK-style projects do not reference implicitly. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin\**;obj\**;stage\**;Output\**;Website\**" />
  </ItemGroup>
</Project>
